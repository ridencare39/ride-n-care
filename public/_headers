# Static-asset cache policy (picked up by the Nitro cloudflare preset build).
# Hashed bundles stay immutable; fonts are renamed on change, so they are safe
# to cache long; brand logos are stable filenames, cached for a week.

# Security headers for static asset responses (HTML gets the same set from the
# Worker in src/server.ts — same values, no conflict; HSTS lives app-side where
# the https check is available).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  cache-control: public, max-age=31536000, immutable

/fonts/*
  cache-control: public, max-age=31536000, immutable

/brands/*
  cache-control: public, max-age=604800
